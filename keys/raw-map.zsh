#!/usr/bin/env zsh

#              ==  0
#
#  ⌘           ==  1
#     ⌥        ==  2
#        ⌃     ==  4
#           ⇧  ==  8
#
#  ⌘  ⌥        ==  3
#  ⌘     ⌃     ==  5
#     ⌥  ⌃     ==  6
#  ⌘        ⇧  ==  9
#     ⌥     ⇧  ==  A
#        ⌃  ⇧  ==  C
#
#  ⌘  ⌥  ⌃     ==  7
#  ⌘  ⌥     ⇧  ==  B
#  ⌘     ⌃  ⇧  ==  D
#     ⌥  ⌃  ⇧  ==  E
#
#  ⌘  ⌥  ⌃  ⇧  ==  F  ==  ✦

# ——————————————————————————————————————————————————————————————————————————— #

function raw_key_mapping() {

  local -ra _modifiers=( '⌘' '⌥' '⌃' '⇧' )

  local -rA _keymap=(
    ['A']="'"   ['C']='§'   ['Q']='`'   ['V']='\'   ['{']='['   ['}']=']'
    ['B']='⌫'   ['D']='⌦'   ['R']='⏎'   ['S']='␣'   ['T']='⇥'
    ['H']='←'   ['J']='↓'   ['K']='↑'   ['L']='→'
    ['Y']='↖'   ['U']='⇟'   ['I']='⇞'   ['O']='↘'

    ['!']='f1'  ['@']='f2'  ['#']='f3'  ['$']='f4'  ['%']='f5'
    ['^']='f6'  ['&']='f7'  ['*']='f8'  ['(']='f9'  [')']='f10'
    ['_']='f11' ['+']='f12' ['-']='f13' ['=']='f14' ['<']='f15'
    ['>']='f16' ['?']='f17' ['~']='f18' [':']='f19' ['Z']='f20'
  )

  # ————————————————————————————————————————————————————————————————————————— #

  if [[ $1 != ($'\e[|'|'^[[|')* ]] {
    echo 'error 1 - invalid binding construct' >&2
    return 1
  }

  # `^[[|Bg`
  local -ra bindings=( "${(@s:|:)1/#($'\e[|'|'^[[|')}" )

  # ——————————————————————————————————————————————————————— #

  local bind keystr
  local -i 16 i tmod mod key

  # ——————————————————————————————————————————————————————— #

  for bind in "${(@)bindings:#}"; {
    mod=$(( 16#$bind[1] )) key=$(( ##$bind[2] ))

    # ————————————————————————————————— #

    for i in {1..4}; {
      if (( mod == 16#F )) {
        echo -n '✦       '
        break

      } elif (( mod & ( 2 ** ( i - 1 ) ) )) {
        echo -n "$_modifiers[i] "

      } elif (( 16#0 > mod || mod > 16#F )) {
        echo 'error 2 - invalid modifier' >&2
        return 2

      } else {
        echo -n '  '
      }
    }

    # ————————————————————————————————— #

    if (( ( ##a <= key && key <= ##z ) || ( ##0 <= key && key <= ##9 ) )) || \
      [[ $bind[2] == ['-=,./;'] ]] {
      # "${(g::):-"\\x${key#*#}"}"
      echo -n "$bind[2]"

    } else {
      keystr="${_keymap[$bind[2]]:-}"

      if [[ $keystr == '' ]] {
        echo 'error 3 - invalid key specifier' >&2
        return 3
      }

      echo -n "$keystr"
    }

    echo

    # ————————————————————————————————— #
  }
}

# ——————————————————————————————————————————————————————————————————————————— #

if [[ "$ZSH_EVAL_CONTEXT" == 'toplevel' ]] raw_key_mapping "$@"

# ——————————————————————————————————————————————————————————————————————————— #

# spell:ignore tmod
